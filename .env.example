# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=fits_db
DB_SSLMODE=disable

# Connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
LOG_LEVEL=info
LOG_DIR=logs
LOG_DEVELOPMENT=false

# ── FITS Processing ───────────────────────────────────────────────────────────
# Directory to recursively scan for .fits / .fit / .fts files
FITS_SCAN_DIR=./testdata

# Number of goroutines processing files in parallel
FITS_WORKERS=4

# Rows per DB insert batch
FITS_BATCH_SIZE=100

# ── JWT / Authentication ──────────────────────────────────────────────────────
# CHANGE THESE in production — use random 32+ char strings
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!

# How long access tokens live (short — 15m recommended)
JWT_ACCESS_TTL=15m

# How long refresh tokens live (longer — 7 days recommended)
JWT_REFRESH_TTL=168h

# HTTP server listen address
SERVER_ADDR=:8080

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=fits-processor
APP_ENV=development
MIGRATIONS_DIR=migrations
