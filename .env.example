# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=fits_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ── JWT / Authentication ──────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── HTTP Server ───────────────────────────────────────────────────────────────
SERVER_ADDR=:8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_RPS=5      # requests/second on /api/auth/* per IP
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_API_RPS=60      # requests/second on all other /api/* per IP
RATE_LIMIT_API_BURST=120

# ── Request Limits ────────────────────────────────────────────────────────────
MAX_BODY_BYTES=1048576     # 1 MB

# ── Static Frontend (leave empty in development, set to ./frontend/dist in production) ──
STATIC_DIR=

# ── FITS Processing ───────────────────────────────────────────────────────────
FITS_SCAN_DIR=./testdata
FITS_WORKERS=4
FITS_BATCH_SIZE=100

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=fits-processor
APP_ENV=development        # development | staging | production
MIGRATIONS_DIR=migrations

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info             # debug | info | warn | error
LOG_DIR=logs
LOG_DEVELOPMENT=false
